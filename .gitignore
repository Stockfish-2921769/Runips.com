# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# pocketbase
/pb_data/

# vercel
.vercel

# Local Community archive processing (contains uncommitted chat exports)
/.local/community-import/

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent scratch. Subagent working directories land here and have contained raw
# WeChat archive exports — original group messages that must never reach a
# public repository.
/.claude/

# One-off shard workers from the archive import. The reusable tooling lives in
# scripts/community-import/; these were per-batch throwaways.
/process_batch.py
/process_*.py

# Python build artefacts
__pycache__/
*.pyc
